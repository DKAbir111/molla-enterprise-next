# ---------------------------------------------------------------------------
# Molla Enterprise — environment
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored. This example is committed — never put secrets here.
#
# Frontend and backend are one Next.js app, so this is the only env file.
# Nothing here is NEXT_PUBLIC_*: the browser calls the API at a relative /api
# path on its own origin, so there is no host for the client to be told about.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------

# Postgres. DIRECT_URL is used by `prisma migrate`; with a local database it
# can be the same as DATABASE_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/molla?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/molla?schema=public"

# Signs JWTs (7-day expiry). Unset falls back to "change-me", which is fine
# locally and unacceptable anywhere else. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=""

# --- Optional --------------------------------------------------------------

# Absolute origin of this app. Used to build password-reset links in emails.
# Default: http://localhost:3000
APP_URL="http://localhost:3000"

# Cloudinary — stores uploaded images (org logos, product images, avatars).
# Uploads fail with 500 if unset. Find it in your Cloudinary dashboard as the
# "API environment variable"; format:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=""

# Email / SMTP. Needed for password resets and the daily alert digest. Leave
# unset to disable email — the app logs a warning and keeps working.
# Port 465 = implicit TLS; anything else = STARTTLS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="you@example.com"
SMTP_PASS=""
SMTP_FROM="Molla Enterprise <no-reply@example.com>"

# Shared secret for the scheduled alerts digest, sent by the scheduler as
# `Authorization: Bearer $CRON_SECRET`. The cron route refuses every request
# without it — it is a public URL, so an unguarded one would let anyone
# trigger a mailout to every organization. Unset disables the route entirely.
# The schedule itself lives in vercel.json.
CRON_SECRET=""
